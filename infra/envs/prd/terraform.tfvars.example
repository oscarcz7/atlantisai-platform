project_id       = "noah-platform-prd"
region           = "us-east1"
api_image        = "us-east1-docker.pkg.dev/noah-platform-prd/noah/api:v1.0.0"
web_image        = "us-east1-docker.pkg.dev/noah-platform-prd/noah/web:v1.0.0"
# Dejar vacio mientras se prueba con URLs *.run.app; poner https://app.tudominio.com cuando tengan dominio
web_url          = ""
# Usar "none" con *.run.app; cambiar a "strict" al migrar a dominio propio
cookie_same_site = "none"
