# Copiar a .env y completar. Nunca versionar .env.

# General
NODE_ENV=development
APP_TIMEZONE_DEFAULT=America/Guayaquil

# API
API_PORT=4000
# Usuario de la aplicación (sin BYPASSRLS)
DATABASE_URL=postgresql://noah_app:noah_app@localhost:5432/noah
# Usuario de migraciones (dueño del esquema)
DATABASE_MIGRATION_URL=postgresql://noah_owner:noah_owner@localhost:5432/noah
JWT_SECRET=cambiar-por-un-valor-largo-aleatorio
# 32 bytes en base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
SENTRY_DSN=

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Almacenamiento (Cloud Storage en la nube; en local se puede usar el disco)
STORAGE_DRIVER=local
STORAGE_BUCKET=

# Correo (invitaciones y recuperación; spec 002)
MAIL_DRIVER=console
MAIL_FROM="Plataforma NOAH <no-reply@example.com>"

# Fase 2: Acceso QR y Edge Gateway Hikvision
GATEWAY_API_TOKEN=cambiar-por-token-secreto-del-gateway
PASS_SIGNING_SECRET=cambiar-por-secreto-hmac-pases-qr
HIKVISION_EMPLOYEE_PREFIX=NX
HIKVISION_CARD_DIGITS=10
PUBLIC_WEB_URL=http://localhost:3000

# Fase 3 (no usar todavía)
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=
# LLM_PROVIDER=
# LLM_API_KEY=
