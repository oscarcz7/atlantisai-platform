# Configuración de NOAH Edge Gateway (PC del edificio)
# Copiar este archivo como ".env" (sin .example) y completar los valores reales.
# Linux: /opt/noah-gateway/.env (root:noah-gateway, permisos 640). Windows: solo SYSTEM y Administradores.

# URL pública de la API de NOAH (sin barra final). Debe ser https:// (http solo para localhost).
GATEWAY_API_URL=https://api.tudominio.com

# Token del gateway de ESTE edificio (dashboard: Acceso -> Rotar token del gateway).
# La API deriva el edificio (tenant) a partir de este token.
GATEWAY_API_TOKEN=CAMBIAR_POR_TOKEN_SECRETO

# Solo se usa con el token compartido de desarrollo; con tokens por edificio la API lo ignora.
GATEWAY_TENANT=noah

# Modo de operación:
#   hikvision = producción (se comunica por ISAPI Digest con los lectores reales)
#   fake      = pruebas locales sin lector físico
GATEWAY_MODE=hikvision

# Intervalo de consulta de comandos a la API (ms)
GATEWAY_POLL_MS=3000

# Intervalo del heartbeat con el estado de cada lector (ms). Independiente del polling.
GATEWAY_HEARTBEAT_MS=60000

# Timeout de cada llamada HTTP a la API y a los lectores ISAPI (ms)
GATEWAY_HTTP_TIMEOUT_MS=10000

# --- Allowlist local de lectores (OBLIGATORIA en modo hikvision) ---
# El gateway solo se conecta a lectores de esta lista; los comandos hacia cualquier otra IP/puerto
# se rechazan sin tocar la red. Loopback, link-local (169.254.x.x, fe80::) y 0.0.0.0 nunca se permiten.
# Formato: lista separada por comas de ip o ip:puerto (IPv6: [fd00::5]:443). Solo IPs, no nombres.
GATEWAY_READER_ALLOWLIST=192.168.1.64:80,192.168.1.65:80

# Opcional: archivo JSON con lectores (se suma a GATEWAY_READER_ALLOWLIST). Permite fijar protocolo,
# código del lector (para el heartbeat) y TLS por lector para HTTPS con certificado autofirmado:
# [
#   { "ip": "192.168.1.64", "port": 80, "protocol": "http", "code": "LECTOR_GYM" },
#   { "ip": "192.168.1.70", "port": 443, "code": "LECTOR_PISCINA",
#     "fingerprint256": "AB:CD:...:EF" },
#   { "ip": "192.168.1.71", "port": 443, "caFile": "/opt/noah-gateway/reader-ca.pem" }
# ]
# fingerprint256 = huella SHA-256 del certificado del lector:
#   openssl s_client -connect 192.168.1.70:443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
# GATEWAY_READERS_FILE=/opt/noah-gateway/readers.json

# Apertura remota de puertas desde la nube (OPEN_DOOR). Desactivada por defecto.
GATEWAY_ALLOW_REMOTE_OPEN=false

# Credenciales ISAPI del lector (Digest). Obligatorias en modo hikvision; sin valor por defecto.
# Recomendado: un usuario ISAPI dedicado, no el "admin" del equipo.
HIKVISION_USER=CAMBIAR_POR_USUARIO_DEL_LECTOR
HIKVISION_PASS=CAMBIAR_POR_CLAVE_DEL_LECTOR

# Prefijo de seguridad para usuarios temporales de visitas (nunca toca residentes)
HIKVISION_EMPLOYEE_PREFIX=NX
