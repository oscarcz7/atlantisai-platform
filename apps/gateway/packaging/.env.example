# Configuración de NOAH Edge Gateway (PC del edificio)
# Copiar este archivo como ".env" (sin .example) y completar los valores reales.

# URL pública de la API de NOAH en producción (sin barra final)
GATEWAY_API_URL=https://api.tudominio.com

# Token secreto compartido con la API (mismo valor que GATEWAY_API_TOKEN en Cloud Run / Secret Manager)
GATEWAY_API_TOKEN=CAMBIAR_POR_TOKEN_SECRETO

# Identificador del condominio/edificio
GATEWAY_TENANT=noah

# Modo de operación:
#   hikvision = producción (se comunica por ISAPI Digest con los lectores reales)
#   fake      = pruebas locales sin lector físico
GATEWAY_MODE=hikvision

# Intervalo de consulta a la API en milisegundos (3000 = cada 3 segundos)
GATEWAY_POLL_MS=3000

# Credenciales del lector Hikvision (ISAPI Digest Auth)
HIKVISION_USER=admin
HIKVISION_PASS=CAMBIAR_POR_CLAVE_DEL_LECTOR

# Prefijo de seguridad para usuarios temporales de visitas (nunca toca residentes)
HIKVISION_EMPLOYEE_PREFIX=NX
