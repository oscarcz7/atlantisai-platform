generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  SUPERADMIN
  ADMIN
  ACCOUNTANT
  GUARD
}

enum StaffTokenType {
  INVITE
  PASSWORD_RESET
}

enum AmenityMode {
  SHARED
  EXCLUSIVE
  FREE_USE
}

enum AdvancePolicy {
  GENERAL
  SHORT_NOTICE_ALLOWED
}

enum OccupancyRole {
  OWNER_RESIDENT
  OWNER_LANDLORD
  LONG_TERM_TENANT
  AIRBNB_HOST
  AIRBNB_GUEST
}

enum ReservationStatus {
  PENDING_PAYMENT
  IN_REVIEW
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  ADMIN_BLOCK
}

enum LedgerEntryType {
  MONTHLY_FEE
  CLEANING
  EXTRA_GUEST
  PARKING_OVERTIME
  DAMAGE
  PAYMENT
  ADJUSTMENT
}

enum DepositMovementType {
  DEPOSIT
  DEDUCTION
  REFUND
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReaderStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum CredentialSyncStatus {
  PENDING
  LOADED
  REVOKE_PENDING
  REVOKED
  ERROR
}

enum GatewayCommandType {
  UPSERT_CREDENTIAL
  REVOKE_CREDENTIAL
  PURGE
  PING
  OPEN_DOOR
}

enum GatewayCommandStatus {
  PENDING
  PROCESSING
  ACKED
  FAILED
}

enum AccessEventResult {
  GRANTED
  DENIED
}

/// Global SaaS table (not tenant-scoped)
model Tenant {
  id           String   @id @db.Uuid
  code         String   @unique
  name         String
  ruc          String?
  logoUrl      String?  @map("logo_url")
  timezone     String   @default("America/Guayaquil")
  contacts     Json?
  officeHours  Json?    @map("office_hours")
  bankAccounts Json?    @map("bank_accounts")
  /// SHA-256 of the per-tenant Edge Gateway token (plaintext is shown once on rotation)
  gatewayTokenHash      String?   @unique @map("gateway_token_hash")
  gatewayTokenRotatedAt DateTime? @map("gateway_token_rotated_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  staffUsers     StaffUserTenant[]
  settings       TenantSettings?
  unitTypes      UnitType[]
  amenities      Amenity[]
  accessRules    AmenityAccessRule[]
  cleaningCombos CleaningCombo[]
  parkingConfig  ParkingConfig?
  units           Unit[]
  persons         Person[]
  occupancies     Occupancy[]
  reservations    Reservation[]
  readers         Reader[]
  credentials     Credential[]
  gatewayCommands GatewayCommand[]
  accessEvents    AccessEvent[]

  @@map("tenants")
}

/// Global SaaS staff users (dashboard & garita)
model StaffUser {
  id                  String    @id @db.Uuid
  email               String    @unique
  fullName            String    @map("full_name")
  passwordHash        String?   @map("password_hash")
  role                StaffRole
  isActive            Boolean   @default(true) @map("is_active")
  totpSecretEnc       String?   @map("totp_secret_enc")
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  totpLastCounter     Int?      @map("totp_last_counter")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenants       StaffUserTenant[]
  sessions      StaffSession[]
  tokens        StaffToken[]
  recoveryCodes StaffRecoveryCode[]
  authAudits    StaffAuthAudit[]

  @@map("staff_users")
}

/// Many-to-many assignment of staff users to buildings
model StaffUserTenant {
  staffUserId String   @map("staff_user_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([staffUserId, tenantId])
  @@index([tenantId])
  @@map("staff_user_tenants")
}

/// Active/revoked refresh token sessions with idle timeout tracking
model StaffSession {
  id               String    @id @db.Uuid
  staffUserId      String    @map("staff_user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_sessions")
}

/// Single-use invitation (72 h) and password reset (1 h) tokens
model StaffToken {
  id          String         @id @db.Uuid
  staffUserId String         @map("staff_user_id") @db.Uuid
  type        StaffTokenType
  tokenHash   String         @unique @map("token_hash")
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz
  usedAt      DateTime?      @map("used_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_tokens")
}

/// Single-use 2FA recovery codes (hashed)
model StaffRecoveryCode {
  id          String    @id @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_recovery_codes")
}

/// Append-only SaaS authentication & staff management audit trail
model StaffAuthAudit {
  id          String   @id @db.Uuid
  staffUserId String?  @map("staff_user_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  ipAddress   String?  @map("ip_address")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([staffUserId, createdAt])
  @@map("staff_auth_audits")
}

/// Append-only tenant-scoped audit trail (forced PostgreSQL RLS)
model AuditLog {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorType String   @map("actor_type")
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  channel   String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // No FK to tenants on purpose: the audit trail must survive tenant deletion.

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Building-level financial & operational parameters (RLS)
model TenantSettings {
  id                          String   @id @db.Uuid
  tenantId                    String   @unique @map("tenant_id") @db.Uuid
  monthlyFeePerSqmCents       Int      @default(0) @map("monthly_fee_per_sqm_cents")
  depositRequiredCents        Int      @map("deposit_required_cents")
  arrearsToleranceMonths      Int      @map("arrears_tolerance_months")
  paymentProofDeadlineMinutes Int      @map("payment_proof_deadline_minutes")
  extraGuestDeclaredCents     Int      @map("extra_guest_declared_cents")
  extraGuestUndeclaredCents   Int      @map("extra_guest_undeclared_cents")
  entryMarginMinutes          Int      @map("entry_margin_minutes")
  generalAdvanceHours         Int      @map("general_advance_hours")
  shortNoticeAdvanceMinutes   Int      @map("short_notice_advance_minutes")
  frequencyWeekStart          String   @default("MONDAY") @map("frequency_week_start")
  /// Day of the billing month (1-31, clamped to the month's last day) on which the monthly fee is due.
  monthlyFeeDueDay            Int      @default(10) @map("monthly_fee_due_day")
  cancellationPolicy          Json?    @map("cancellation_policy")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_settings")
}

/// Unit typology with included guest quota (RLS)
model UnitType {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String
  name           String
  bedrooms       Int      @default(1)
  includedGuests Int      @map("included_guests")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units  Unit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("unit_types")
}

/// Communal area catalog with rules (RLS)
model Amenity {
  id                 String        @id @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  code               String
  name               String
  capacity           Int
  maxDurationMinutes Int           @map("max_duration_minutes")
  schedule           Json?
  frequency          Json?
  mode               AmenityMode
  advancePolicy      AdvancePolicy @map("advance_policy")
  appliesGuestQuota  Boolean       @default(false) @map("applies_guest_quota")
  requiresDeposit    Boolean       @default(false) @map("requires_deposit")
  cleaningFeeCents   Int           @default(0) @map("cleaning_fee_cents")
  hasReader          Boolean       @default(false) @map("has_reader")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessRules AmenityAccessRule[]
  reservations ReservationAmenity[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("amenities")
}

/// Access matrix: which OccupancyRole can use which Amenity (RLS)
model AmenityAccessRule {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  amenityId     String        @map("amenity_id") @db.Uuid
  occupancyRole OccupancyRole @map("occupancy_role")
  allowed       Boolean       @default(false)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, amenityId, occupancyRole])
  @@index([tenantId])
  @@map("amenity_access_rules")
}

/// Cleaning combos covering exact sets of amenities (RLS)
model CleaningCombo {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  comboKey   String   @map("combo_key")
  amenityIds String[] @map("amenity_ids") @db.Uuid
  feeCents   Int      @map("fee_cents")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, comboKey])
  @@index([tenantId])
  @@map("cleaning_combos")
}

/// Visitor parking rules per building (RLS)
model ParkingConfig {
  id                      String   @id @db.Uuid
  tenantId                String   @unique @map("tenant_id") @db.Uuid
  spots                   Int
  freeMinutes             Int      @map("free_minutes")
  overtimeFeeCentsPerHour Int      @map("overtime_fee_cents_per_hour")
  rounding                String   @default("CEIL_HOUR")
  /// Minutes before the free parking window ends at which the guard console raises an alert.
  alertMarginMinutes      Int      @default(15) @map("alert_margin_minutes")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("parking_configs")
}

/// Residential unit in a building (RLS)
model Unit {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  number          String
  floor           Int
  unitTypeId      String   @map("unit_type_id") @db.Uuid
  areaSqm         Float?   @map("area_sqm")
  bedrooms        Int      @default(1)
  monthlyFeeCents Int      @default(0) @map("monthly_fee_cents")
  /// true when the admin entered the fee explicitly; false = derived from areaSqm × monthlyFeePerSqmCents.
  monthlyFeeIsManual Boolean @default(false) @map("monthly_fee_is_manual")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitType    UnitType    @relation(fields: [unitTypeId], references: [id])
  occupancies Occupancy[]
  reservations Reservation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("units")
}

/// Resident, owner, host or guest person (RLS, encrypted national ID, unique WhatsApp phone per tenant)
model Person {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  fullName       String    @map("full_name")
  nationalIdEnc  String    @map("national_id_enc")
  nationalIdHash String    @map("national_id_hash")
  nationalIdMask String    @map("national_id_mask")
  waPhone        String    @map("wa_phone")
  email          String?
  consentAt      DateTime? @map("consent_at") @db.Timestamptz
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occupancies Occupancy[]
  reservations Reservation[]

  @@unique([tenantId, waPhone])
  @@index([tenantId])
  @@index([tenantId, nationalIdHash])
  @@map("persons")
}

/// Person-to-unit occupancy with role and validity window (RLS)
model Occupancy {
  id        String        @id @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  personId  String        @map("person_id") @db.Uuid
  unitId    String        @map("unit_id") @db.Uuid
  role      OccupancyRole
  validFrom DateTime      @map("valid_from") @db.Timestamptz
  validTo   DateTime?     @map("valid_to") @db.Timestamptz
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, unitId])
  @@index([tenantId, personId])
  @@map("occupancies")
}

/// Amenity reservation or administrative block (RLS)
model Reservation {
  id                 String            @id @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  unitId             String?           @map("unit_id") @db.Uuid
  personId           String?           @map("person_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz
  endsAt             DateTime          @map("ends_at") @db.Timestamptz
  declaredAttendees  Int               @default(1) @map("declared_attendees")
  status             ReservationStatus
  channel            String            @default("DASHBOARD")
  totalCents         Int               @default(0) @map("total_cents")
  charges            Json?
  holdExpiresAt      DateTime?         @map("hold_expires_at") @db.Timestamptz
  cancellationReason String?           @map("cancellation_reason")
  idempotencyKey     String?           @map("idempotency_key")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?                 @relation(fields: [unitId], references: [id], onDelete: SetNull)
  person    Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  amenities   ReservationAmenity[]
  attendees   ReservationAttendee[]
  credentials Credential[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, status, holdExpiresAt])
  @@map("reservations")
}

/// Join table linking a reservation to one or more amenities (combos) (RLS)
model ReservationAmenity {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  amenityId     String   @map("amenity_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amenity     Amenity     @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([reservationId, amenityId])
  @@index([tenantId, amenityId])
  @@map("reservation_amenities")
}

/// Declared attendees for a reservation (RLS)
model ReservationAttendee {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  name          String?
  waPhone       String?  @map("wa_phone")
  isExtra       Boolean  @default(false) @map("is_extra")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([tenantId, reservationId])
  @@map("reservation_attendees")
}

/// Unit ledger entries: positive = charge, negative = payment/credit (RLS)
model LedgerEntry {
  id          String          @id @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  unitId      String          @map("unit_id") @db.Uuid
  type        LedgerEntryType
  amountCents Int             @map("amount_cents")
  description String
  reference   String?
  dueDate     DateTime?       @map("due_date") @db.Timestamptz
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, unitId])
  @@index([tenantId, unitId, type, dueDate])
  @@map("ledger_entries")
}

/// Deposit account balance per unit (RLS)
model DepositAccount {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  balanceCents Int      @default(0) @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  movements DepositMovement[]

  @@unique([tenantId, unitId])
  @@index([tenantId])
  @@map("deposit_accounts")
}

/// Deposit movements: deposits, damage deductions with reason/evidence, refunds (RLS)
model DepositMovement {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  depositAccountId String              @map("deposit_account_id") @db.Uuid
  type             DepositMovementType
  amountCents      Int                 @map("amount_cents")
  reason           String
  evidenceKey      String?             @map("evidence_key")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  depositAccount DepositAccount @relation(fields: [depositAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, depositAccountId])
  @@map("deposit_movements")
}

/// Payment proof submitted for accountant review (RLS)
model PaymentProof {
  id              String             @id @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  unitId          String             @map("unit_id") @db.Uuid
  reservationId   String?            @map("reservation_id") @db.Uuid
  fileKey         String             @map("file_key")
  bank            String
  amountCents     Int                @map("amount_cents")
  transferDate    DateTime           @map("transfer_date") @db.Timestamptz
  reference       String
  extractedBy     String             @default("HUMAN") @map("extracted_by")
  status          PaymentProofStatus @default(PENDING)
  reviewedBy      String?            @map("reviewed_by")
  rejectionReason String?            @map("rejection_reason")
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, status])
  @@index([tenantId, reference, amountCents])
  @@map("payment_proofs")
}

/// Sequential collection receipt per building (RLS)
model CollectionReceipt {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  unitId          String   @map("unit_id") @db.Uuid
  sequenceNumber  Int      @map("sequence_number")
  receiptCode     String   @map("receipt_code")
  amountCents     Int      @map("amount_cents")
  paymentProofId  String?  @map("payment_proof_id") @db.Uuid
  ledgerEntryIds  String[] @map("ledger_entry_ids") @db.Uuid
  issuedAt        DateTime @default(now()) @map("issued_at") @db.Timestamptz

  @@unique([tenantId, sequenceNumber])
  @@index([tenantId, unitId])
  @@map("collection_receipts")
}

/// Visitor log & parking spot timer for garita console (RLS)
model Visit {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  hostUnitId     String    @map("host_unit_id") @db.Uuid
  visitorName    String    @map("visitor_name")
  nationalIdEnc  String    @map("national_id_enc")
  nationalIdMask String    @map("national_id_mask")
  plate          String?
  needsParking   Boolean   @default(false) @map("needs_parking")
  parkingSpot    Int?      @map("parking_spot")
  expectedAt     DateTime  @map("expected_at") @db.Timestamptz
  checkInAt      DateTime? @map("check_in_at") @db.Timestamptz
  checkOutAt     DateTime? @map("check_out_at") @db.Timestamptz
  overtimeCents  Int       @default(0) @map("overtime_cents")
  registeredBy   String    @map("registered_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, expectedAt])
  @@index([tenantId, parkingSpot, checkOutAt])
  @@map("visits")
}

/// Incident tickets with 48h duplicate detection (RLS)
model Ticket {
  id          String        @id @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  category    String
  location    String
  description String
  urgency     TicketUrgency @default(MEDIUM)
  status      TicketStatus  @default(OPEN)
  photos      String[]      @default([])
  reportedBy  String        @map("reported_by")
  assignedTo  String?       @map("assigned_to")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  subscribers TicketSubscriber[]

  @@index([tenantId, status])
  @@index([tenantId, location, category, createdAt])
  @@map("tickets")
}

/// Residents/staff subscribed to ticket closure notifications (RLS)
model TicketSubscriber {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, personId])
  @@index([tenantId, ticketId])
  @@map("ticket_subscribers")
}

/// Hikvision DS-K1T344EBFWX-E1 access control reader per communal area (RLS)
model Reader {
  id         String       @id @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  code       String
  name       String
  serial     String?
  model      String       @default("DS-K1T344EBFWX-E1")
  protocol   String       @default("http")
  ip         String
  port       Int          @default(80)
  doorNo     Int          @default(1) @map("door_no")
  firmware   String?
  amenityIds String[]     @default([]) @map("amenity_ids") @db.Uuid
  status     ReaderStatus @default(UNKNOWN)
  lastSeenAt DateTime?    @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commands GatewayCommand[]
  events   AccessEvent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("readers")
}

/// Temporary QR access credential bound to a reservation (RLS)
model Credential {
  id            String               @id @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  reservationId String?              @map("reservation_id") @db.Uuid
  employeeNo    String               @map("employee_no")
  code          String
  readerIds     String[]             @default([]) @map("reader_ids") @db.Uuid
  validFrom     DateTime             @map("valid_from") @db.Timestamptz
  validTo       DateTime             @map("valid_to") @db.Timestamptz
  maxOpens      Int?                 @map("max_opens")
  syncStatus    CredentialSyncStatus @default(PENDING) @map("sync_status")
  lastError     String?              @map("last_error")
  syncedAt      DateTime?            @map("synced_at") @db.Timestamptz
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation Reservation?     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  commands    GatewayCommand[]
  events      AccessEvent[]

  @@unique([tenantId, employeeNo])
  @@unique([tenantId, code])
  @@index([tenantId, reservationId])
  @@index([tenantId, syncStatus])
  @@map("credentials")
}

/// Idempotent command queue consumed by apps/gateway (RLS)
model GatewayCommand {
  id             String               @id @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  readerId       String?              @map("reader_id") @db.Uuid
  credentialId   String?              @map("credential_id") @db.Uuid
  idempotencyKey String               @map("idempotency_key")
  type           GatewayCommandType
  payload        Json
  status         GatewayCommandStatus @default(PENDING)
  attempts       Int                  @default(0)
  lastError      String?              @map("last_error")
  ackedAt        DateTime?            @map("acked_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reader     Reader?     @relation(fields: [readerId], references: [id], onDelete: SetNull)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@map("gateway_commands")
}

/// Real-time access events forwarded by Hikvision readers via Edge Gateway (RLS)
model AccessEvent {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  readerId       String?           @map("reader_id") @db.Uuid
  credentialId   String?           @map("credential_id") @db.Uuid
  employeeNo     String?           @map("employee_no")
  credentialCode String?           @map("credential_code")
  result         AccessEventResult
  occurredAt     DateTime          @map("occurred_at") @db.Timestamptz
  rawPayload     Json?             @map("raw_payload")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reader     Reader?     @relation(fields: [readerId], references: [id], onDelete: SetNull)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, readerId])
  @@map("access_events")
}
