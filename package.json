{
  "name": "noah-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @noah/api prisma migrate dev",
    "db:seed": "pnpm --filter @noah/api seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "^2.5.0",
      "body-parser@<1.20.9": "^1.20.9",
      "qs@<6.17.0": "^6.17.1",
      "postcss@<8.5.23": "^8.5.33"
    }
  }
}
